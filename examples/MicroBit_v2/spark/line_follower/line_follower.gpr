--  The flashable program: the proved core plus the hardware shell.
--  Prove the core with proof.gpr instead (see that file for why they are split).

with "../../../../boards/MicroBit_v2/microbit_v2_full.gpr";

project Line_Follower is

   for Source_Dirs use ("src", "src/core");
   for Object_Dir use "obj";
   for Main use ("main.adb");
   for Create_Missing_Dirs use "True";

   for Target use "arm-eabi";
   for Runtime ("ada") use "embedded-nrf52833";

   package Compiler is
      for Switches ("ada") use ("-gnat2022", "-g");
   end Compiler;

   package Builder is
      for Switches ("ada") use ("-g");
   end Builder;

   package Linker is
      for Switches ("ada") use ("-g", "-Wl,--print-memory-usage");
   end Linker;

   package Ide is
      for Connection_Tool use "pyocd";
      for Program_Host use ":1234";
      for Communication_Protocol use "remote";
   end Ide;

end Line_Follower;
