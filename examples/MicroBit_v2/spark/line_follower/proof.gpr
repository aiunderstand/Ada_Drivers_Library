--  Proof-only view of this example: the hardware-free core, and nothing else.
--
--  GNATprove analyses every unit it can see, and the Ada Drivers Library is not
--  SPARK, so the provable core is kept in its own project with no dependency on
--  it. The flashable program is line_follower.gpr.

project Proof is

   for Source_Dirs use ("src/core");
   for Object_Dir use "obj/proof";  --  under obj/, which the ADL already gitignores
   for Target use "arm-eabi";
   for Runtime ("Ada") use "embedded-nrf52833";

   package Compiler is
      for Switches ("ada") use ("-gnat2022", "-g");
   end Compiler;

end Proof;
