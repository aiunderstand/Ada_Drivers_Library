--  Proof-only view of this example.
--
--  GNATprove analyses every unit it can see, and the Ada Drivers Library is not
--  SPARK (for example STMPE1600_Expander uses an access discriminant, which
--  SPARK does not allow). So the provable core gets its own project with no
--  dependency on the ADL, and that is what gets proved.
--
--  The flashable program is bounded_queue.gpr, which builds the same core plus
--  the hardware shell in src/.

project Proof is

   for Source_Dirs use ("src/core");
   for Object_Dir use "obj/proof";  --  under obj/, which the ADL already gitignores
   for Target use "arm-eabi";
   for Runtime ("Ada") use "embedded-nrf52833";

   package Compiler is
      for Switches ("ada") use ("-gnat2022", "-g");
   end Compiler;

end Proof;
